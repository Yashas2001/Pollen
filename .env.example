ANTHROPIC_API_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
PEXELS_API_KEY=
# Premade ElevenLabs voice (George). Swap any voice id here.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# Public base URL the renderer uses to fetch job files (tunnel URL when public)
APP_URL=http://localhost:3000
# Which model writes the videos: "azure" (Luna) or "anthropic" (Claude)
WRITER=azure
AZURE_OPENAI_ENDPOINT=https://<resource>.services.ai.azure.com/openai/v1/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5.6-luna

# YouTube Data API key (YouTube only)
YOUTUBE_API_KEY=
# Leave unset for the lean way (~177 YouTube units a run). "classic" = old way: 2 searches, ~343 units.
RESEARCH_MODE=
# Free runs per Google account (default 2); past that, the Pro waitlist. ADMIN_EMAILS have no limit.
FREE_RUNS=
# Optional: runs made before this time (ISO, e.g. 2026-10-24T11:30:00Z) do not count toward FREE_RUNS.
FREE_RUNS_SINCE=
# One or more Bright Data keys, comma separated: a refused key (bad, out of balance, zone off) is skipped for an hour
BRIGHTDATA_API_KEY=
# Optional: several ElevenLabs keys, comma separated
ELEVENLABS_API_KEYS=

# Firebase (project pollen-5761b): Google sign-in. Web config is public by design.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyD_71eDUdTjP08w-MLPzXvmRz7NBr0XVfA
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=pollen-5761b.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=pollen-5761b
NEXT_PUBLIC_FIREBASE_APP_ID=1:193823546832:web:f3863fb668b422abfeadd5
# Who can open /admin (comma separated)
ADMIN_EMAILS=

# AgenticOrg (Pine Labs hackathon instance)
AGENTICORG_BASE_URL=https://agenticorg.hackathon.pinelabs.com
# API key (starts with ao_sk_), needs permission to run agents; only a tenant admin can create one
AGENTICORG_API_KEY=
# The Reply Coach agent's UUID, from its page in the dashboard
AGENTICORG_REPLY_COACH_ID=
